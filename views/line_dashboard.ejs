<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LINE Bot - Welloff</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-12 font-sans antialiased text-gray-900">
    <%- include('partials/navbar') %>

    <div class="max-w-7xl mx-auto px-4 mt-6">
        <div class="bg-emerald-600 text-white p-6 rounded-3xl shadow-md mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-extrabold">Welloff LINE Bot</h1>
                <p class="text-sm">สถานะแพ็กเกจ: <span class="font-bold text-yellow-300"><%= user.packageStatus %></span></p>
            </div>
            <% if(user.packageStatus === 'FREE') { %>
                <a href="/topup" class="bg-white text-emerald-600 px-4 py-2 rounded-xl font-bold text-sm">อัปเกรด 150฿</a>
            <% } %>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- ซ้าย: สั่งงาน -->
            <div class="lg:col-span-1 space-y-6">

                <!-- ฟอร์มเพิ่มบัญชี -->
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="font-bold text-emerald-600 mb-4 border-b pb-2"><i class="fab fa-line mr-1"></i> ผูกบัญชี LINE ส่วนตัว</h2>
                    <form action="/api/line/add" method="POST" class="space-y-3">
                        <input type="text" name="groupName" required placeholder="ชื่อเรียกบัญชี" class="w-full border p-2 rounded-xl text-sm outline-none">
                        <input type="email" name="lineEmail" required placeholder="อีเมล LINE" class="w-full border p-2 rounded-xl text-sm outline-none">
                        <input type="password" name="linePassword" required placeholder="รหัสผ่าน LINE" class="w-full border p-2 rounded-xl text-sm outline-none">
                        <button class="w-full bg-slate-800 text-white py-2 rounded-xl text-sm font-bold">เพิ่มบัญชี LINE</button>
                    </form>
                </div>

                <!-- ฟอร์มสั่งงาน -->
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="font-bold text-emerald-600 mb-4 border-b pb-2"><i class="fas fa-paper-plane mr-1"></i> สั่งงานบอท LINE</h2>
                    <form id="lineJobForm" class="space-y-4">
                        <input type="hidden" id="platform" value="LINE">
                        
                        <!-- เลือกบัญชี & ปุ่มซิงค์กลุ่ม -->
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">เลือกบัญชีที่ใช้งาน</label>
                            <div class="flex gap-2">
                                <select id="accountId" onchange="updateGroupDropdown()" class="w-full border p-3 rounded-xl font-bold text-sm bg-emerald-50 text-emerald-800">
                                    <option value="">-- เลือกบัญชี --</option>
                                    <% if(lineAccounts && lineAccounts.length > 0) { lineAccounts.forEach(acc => { %>
                                        <option value="<%= acc.id %>"><%= acc.groupName %></option>
                                    <% }) } %>
                                </select>
                                <button type="button" onclick="syncGroups()" class="bg-indigo-500 hover:bg-indigo-600 text-white px-3 rounded-xl text-xs font-bold whitespace-nowrap shadow-sm transition">
                                    <i class="fas fa-sync-alt mr-1"></i> ดึงกลุ่ม
                                </button>
                            </div>
                        </div>

                        <!-- 💡 ระบบใหม่: Dropdown เลือกกลุ่มเป้าหมายแทนการพิมพ์ -->
                        <div>
                            <label class="block text-xs font-bold text-gray-500 mb-1">เลือกกลุ่มเป้าหมาย (รายชื่อกลุ่ม)</label>
                            <select id="targetUrl" required class="w-full border p-3 rounded-xl text-sm outline-none font-bold">
                                <option value="">โปรดเลือกบัญชีและกด 'ดึงกลุ่ม' ก่อน</option>
                            </select>
                        </div>

                        <!-- โหมดการทำงาน -->
                        <div class="grid grid-cols-3 gap-2">
                            <label class="cursor-pointer"><input type="radio" name="mode" value="IMMEDIATE" checked onchange="toggleMode()" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-emerald-600 peer-checked:text-white text-xs font-bold">ด่วน</div></label>
                            <label class="cursor-pointer"><input type="radio" name="mode" value="SCHEDULE" onchange="toggleMode()" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-emerald-600 peer-checked:text-white text-xs font-bold">ตั้งเวลา</div></label>
                            <label class="cursor-pointer"><input type="radio" name="mode" value="KEYWORD" onchange="toggleMode()" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-emerald-600 peer-checked:text-white text-xs font-bold">คีย์เวิร์ด</div></label>
                        </div>

                        <input type="datetime-local" id="scheduleTime" class="w-full border p-2 rounded-xl text-sm hidden">
                        <input type="text" id="keyword" placeholder="คำดักจับ (เช่น เรท)" class="w-full border p-2 rounded-xl text-sm hidden">
                        
                        <textarea id="message" required placeholder="ข้อความจองแชร์" rows="2" class="w-full border p-3 rounded-xl text-sm outline-none"></textarea>
                        
                        <!-- จำนวนรอบ -->
                        <div class="grid grid-cols-3 gap-2">
                            <label class="cursor-pointer"><input type="radio" name="repeat" value="1" checked class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-emerald-100 peer-checked:border-emerald-500 peer-checked:text-emerald-700 text-xs font-bold">1 รอบ</div></label>
                            <label class="cursor-pointer"><input type="radio" name="repeat" value="2" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-emerald-100 peer-checked:border-emerald-500 peer-checked:text-emerald-700 text-xs font-bold">2 รอบ</div></label>
                            <label class="cursor-pointer"><input type="radio" name="repeat" value="3" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-emerald-100 peer-checked:border-emerald-500 peer-checked:text-emerald-700 text-xs font-bold">3 รอบ</div></label>
                        </div>

                        <button type="button" onclick="submitJob()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition shadow-md">
                            ยิงส่งงานบอท
                        </button>
                    </form>
                </div>
            </div>

            <!-- ขวา: บัญชีและประวัติ -->
            <div class="lg:col-span-2 space-y-6">
                <!-- รายการบัญชี -->
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="font-bold text-gray-700 border-b pb-3 mb-4"><i class="fas fa-id-card mr-2 text-emerald-500"></i> บัญชีที่เชื่อมต่อไว้</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% if(lineAccounts && lineAccounts.length > 0) { lineAccounts.forEach(acc => { %>
                            <div class="bg-gray-50 border border-gray-100 p-4 rounded-2xl flex justify-between items-center">
                                <div>
                                    <p class="font-bold text-gray-800 text-sm"><%= acc.groupName %></p>
                                    <p class="text-[10px] text-gray-500"><%= acc.lineEmail %></p>
                                </div>
                                <button onclick="deleteLineAccount('<%= acc.id %>')" class="text-red-500 text-xs font-bold px-2"><i class="fas fa-trash-alt"></i></button>
                            </div>
                        <% }) } else { %>
                            <p class="text-sm text-gray-400">ยังไม่มีบัญชี</p>
                        <% } %>
                    </div>
                </div>

                <!-- ประวัติงาน -->
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <div class="flex justify-between items-center border-b pb-3 mb-4">
                        <h2 class="font-bold text-gray-700">ประวัติงานล่าสุด</h2>
                        <button onclick="clearHistory('line')" class="text-xs text-red-500 font-bold hover:underline">ล้างประวัติ</button>
                    </div>
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50 text-xs text-gray-500"><tr><th class="p-3">โหมด</th><th class="p-3">กลุ่ม / ข้อความ</th><th class="p-3">เวลา</th><th class="p-3">สถานะ</th></tr></thead>
                        <tbody>
                            <% if (typeof jobs !== 'undefined' && jobs.length > 0) { jobs.forEach(job => { %>
                                <tr class="border-b border-gray-50">
                                    <td class="p-3 font-bold text-emerald-600 text-xs"><%= job.mode %></td>
                                    <td class="p-3"><div class="font-bold text-xs truncate max-w-[150px]"><%= job.targetUrl %></div><div class="text-[10px] text-gray-500 truncate max-w-[150px]"><%= job.message %></div></td>
                                    <td class="p-3 text-[10px] text-gray-500"><%= new Date(job.runAt).toLocaleString('th-TH') %></td>
                                    <td class="p-3 font-bold text-[10px]"><%= job.status %></td>
                                </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 💡 Modal หน้าต่างดูกล้องสด (Live View) สำหรับสแกน QR และดูรหัส PIN -->
    <div id="qrModal" class="fixed inset-0 bg-black bg-opacity-70 z-50 hidden flex items-center justify-center backdrop-blur-sm transition-all">
        <div class="bg-white p-6 rounded-3xl max-w-md w-full text-center shadow-2xl mx-4">
            <h3 class="font-extrabold text-xl text-emerald-600 mb-2"><i class="fas fa-qrcode mr-2"></i> สแกนเพื่อเข้าสู่ระบบ</h3>
            <p class="text-sm text-gray-500 mb-4">ภาพจะอัปเดตอัตโนมัติ สแกน QR แล้วรอดูรหัส PIN ที่นี่...</p>
            
            <div class="bg-gray-50 border-2 border-dashed border-gray-200 p-2 rounded-2xl mb-5 flex justify-center min-h-[300px] items-center relative overflow-hidden">
                <!-- รูประบบจะโหลดมาใส่ตรงนี้ -->
                <img id="qrLiveImage" src="/line-qr-code.png" class="rounded-xl max-w-full object-contain z-10" style="max-height: 300px;" alt="กำลังรอภาพจากบอท...">
                <div class="absolute inset-0 flex items-center justify-center z-0 text-gray-300">
                    <i class="fas fa-circle-notch fa-spin text-4xl"></i>
                </div>
            </div>
            
            <button type="button" onclick="closeQrModal()" class="bg-slate-100 hover:bg-red-500 hover:text-white text-gray-600 px-4 py-3 rounded-xl text-sm font-bold w-full transition duration-300">
                ยกเลิก / ปิดหน้าต่าง
            </button>
        </div>
    </div>

    <!-- โค้ดส่งข้อมูลไป Backend -->
    <script>
        // ข้อมูลบัญชีที่ถูกเรนเดอร์มาจาก Backend
        const accountsData = <%- JSON.stringify(lineAccounts || []) %>;

        // อัปเดต Dropdown เมื่อเปลี่ยนบัญชี
        function updateGroupDropdown() {
            const accId = document.getElementById('accountId').value;
            const targetSelect = document.getElementById('targetUrl');
            targetSelect.innerHTML = '';

            const acc = accountsData.find(a => a.id == accId);
            if (acc && acc.fetchedGroups) {
                try {
                    const groups = JSON.parse(acc.fetchedGroups);
                    if(groups.length > 0) {
                        groups.forEach(g => {
                            targetSelect.innerHTML += `<option value="${g}">${g}</option>`;
                        });
                    } else {
                        targetSelect.innerHTML = '<option value="">ไม่พบกลุ่ม (ลองกดดึงกลุ่มอีกครั้ง)</option>';
                    }
                } catch(e) {
                    targetSelect.innerHTML = '<option value="">ข้อมูลกลุ่มผิดพลาด กรุณากดดึงกลุ่มใหม่</option>';
                }
            } else {
                targetSelect.innerHTML = '<option value="">กรุณากดปุ่ม "ดึงกลุ่ม" ก่อนใช้งาน</option>';
            }
        }

        // 💡 ตัวแปรสำหรับเก็บคำสั่งรีเฟรชรูป
        let liveImageInterval;

        // 💡 ฟังก์ชันปิดหน้าต่างและหยุดการโหลดรูป
        function closeQrModal() {
            document.getElementById('qrModal').classList.add('hidden');
            clearInterval(liveImageInterval);
        }

        // 🟢 ฟังก์ชันสั่งบอทไปดึงกลุ่ม (อัปเดตแบบเปิดกล้องดูสด)
        async function syncGroups() {
            const accId = document.getElementById('accountId').value;
            if(!accId) return alert('โปรดเลือกบัญชีที่ต้องการดึงกลุ่มก่อนครับ');
            
            const btn = event.currentTarget;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> กำลังดึง...';
            btn.disabled = true;

            // 1. เปิดกล่องหน้าต่าง Modal โชว์ขึ้นมากลางจอ
            document.getElementById('qrModal').classList.remove('hidden');
            
            // 2. สั่งให้รูปภาพรีเฟรชตัวเองทุกๆ 2 วินาที (เปลี่ยนจาก QR เป็น PIN อัตโนมัติ)
            liveImageInterval = setInterval(() => {
                // ใส่ ?t=... ต่อท้าย เพื่อบังคับให้เบราว์เซอร์ไม่จำแคช และโหลดรูปใหม่ล่าสุดเสมอ
                document.getElementById('qrLiveImage').src = '/line-qr-code.png?t=' + new Date().getTime();
            }, 2000);

            try {
                // ส่งคำสั่งไปให้บอทเริ่มทำงาน
                const res = await fetch('/api/line/sync', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ accountId: accId })
                });
                const data = await res.json();
                
                // 3. พอบอททำงานเสร็จ (สแกนผ่าน หรือ Error) ให้ปิดหน้าต่างและหยุดรีเฟรชรูป
                closeQrModal();

                if(data.success) {
                    alert(`✅ ยืนยันสำเร็จ! ดึงข้อมูลมาได้ ${data.groups.length} กลุ่ม`);
                    location.reload(); 
                } else {
                    alert('⚠️ แจ้งเตือน: ' + data.error);
                }
            } catch(e) {
                closeQrModal();
                alert('❌ การเชื่อมต่อล้มเหลว');
            } finally {
                btn.innerHTML = '<i class="fas fa-sync-alt mr-1"></i> ดึงกลุ่ม';
                btn.disabled = false;
            }
        }

        // ฟังก์ชันอื่นๆ เดิม
        function toggleMode() {
            const mode = document.querySelector('input[name="mode"]:checked').value;
            document.getElementById('scheduleTime').classList.toggle('hidden', mode !== 'SCHEDULE');
            document.getElementById('keyword').classList.toggle('hidden', mode !== 'KEYWORD');
        }

        async function submitJob() {
            const data = {
                platform: 'LINE',
                accountId: document.getElementById('accountId').value,
                mode: document.querySelector('input[name="mode"]:checked').value,
                targetUrl: document.getElementById('targetUrl').value, 
                message: document.getElementById('message').value,
                scheduleTime: document.getElementById('scheduleTime').value,
                keyword: document.getElementById('keyword').value,
                repeat: document.querySelector('input[name="repeat"]:checked').value
            };
            if(!data.accountId || !data.targetUrl) return alert('กรุณาเลือกบัญชีและกลุ่มเป้าหมายให้ครบถ้วน');
            
            const res = await fetch('/api/jobs/send', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
            });
            if(res.ok) location.reload();
        }

        async function deleteLineAccount(id) {
            if(confirm('ยืนยันลบบัญชี?')) {
                await fetch(`/api/line/delete/${id}`, { method: 'DELETE' });
                location.reload();
            }
        }
        async function clearHistory(platform) {
            if(confirm('ล้างประวัติ?')) {
                await fetch(`/api/jobs/clear/${platform}`, { method: 'DELETE' });
                location.reload();
            }
        }

        // โหลด Dropdown ตอนเปิดหน้าเว็บครั้งแรก
        window.onload = updateGroupDropdown;
    </script>
</body>
</html>
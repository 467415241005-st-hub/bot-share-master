<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LINE Bot Dashboard - Welloff</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        input, textarea, select { font-size: 16px !important; }
    </style>
</head>
<body class="bg-gray-50 pb-12 font-sans antialiased text-gray-900">

    <%- include('partials/navbar') %>

    <div class="max-w-7xl mx-auto px-4 mt-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
            
            <div class="space-y-6">
                
                <div class="bg-white p-5 md:p-6 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 flex items-center text-green-600">
                        <i class="fas fa-paper-plane mr-2"></i> สั่งงานบอท (LINE)
                    </h2>
                    
                    <form action="/api/jobs/add" method="POST" class="space-y-4">
                        <div class="p-3 bg-gray-50 border border-gray-100 rounded-2xl">
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-2">รูปแบบทำงาน</label>
                            <div class="grid grid-cols-2 gap-2">
                                <label class="cursor-pointer">
                                    <input type="radio" name="mode" value="SCHEDULE" checked onchange="toggleLineMode()" class="peer sr-only">
                                    <div class="text-center py-2.5 bg-white border border-gray-200 rounded-xl peer-checked:bg-green-600 peer-checked:border-green-600 peer-checked:text-white font-bold transition text-sm">⏰ ตั้งเวลาส่ง</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="mode" value="KEYWORD" onchange="toggleLineMode()" class="peer sr-only">
                                    <div class="text-center py-2.5 bg-white border border-gray-200 rounded-xl peer-checked:bg-green-600 peer-checked:border-green-600 peer-checked:text-white font-bold transition text-sm">👀 จองหลังเรท</div>
                                </label>
                            </div>
                        </div>

                        <div id="lineKeywordBox" class="hidden">
                            <label class="block text-sm font-semibold text-red-600 mb-1">คีย์เวิร์ดดักจับของท้าวแชร์</label>
                            <input type="text" name="keyword" placeholder="เช่น ตั้งค่า: 17, วางเรท" class="w-full border-red-200 bg-red-50/50 border p-3 rounded-xl focus:ring-2 focus:ring-red-500 outline-none text-base">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">จำนวนข้อความส่ง</label>
                            <div class="grid grid-cols-3 gap-2">
                                <label class="cursor-pointer">
                                    <input type="radio" name="repeat" value="1" checked class="peer sr-only">
                                    <div class="text-center py-2 border border-gray-200 rounded-xl peer-checked:bg-green-50 peer-checked:border-green-500 peer-checked:text-green-700 font-bold transition text-sm">1 ข้อความ</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="repeat" value="2" class="peer sr-only">
                                    <div class="text-center py-2 border border-gray-200 rounded-xl peer-checked:bg-green-50 peer-checked:border-green-500 peer-checked:text-green-700 font-bold transition text-sm">2 ข้อความ</div>
                                </label>
                                <label class="cursor-pointer">
                                    <input type="radio" name="repeat" value="3" class="peer sr-only">
                                    <div class="text-center py-2 border border-gray-200 rounded-xl peer-checked:bg-green-50 peer-checked:border-green-500 peer-checked:text-green-700 font-bold transition text-sm">3 ข้อความ</div>
                                </label>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">เลือกบัญชี LINE</label>
                            <select name="accountId" required class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none bg-white text-base">
                                <option value="" disabled selected>-- เลือกบัญชีไลน์ --</option>
                                <% if (lineAccounts && lineAccounts.length > 0) { %>
                                    <% lineAccounts.forEach(acc => { %>
                                        <option value="<%= acc.id %>"><%= acc.groupName %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">ชื่อกลุ่มเป้าหมายไลน์ (สะกดให้ตรงเป๊ะ)</label>
                            <input type="text" name="targetUrl" placeholder="เช่น กลุ่มแชร์ VIP ทองคำ" required class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none text-base">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">ข้อความที่จะพิมพ์ส่ง</label>
                            <textarea name="message" rows="3" required placeholder="จอง 1 ขา" class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none text-base"></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">เวลาส่ง (ถ้าเลือกตั้งเวลา)</label>
                            <input type="datetime-local" name="runAt" class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none text-base">
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 pt-2">
                            <button type="submit" class="w-full sm:flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3.5 rounded-xl transition shadow-md text-base">
                                ยืนยันการตั้งค่า
                            </button>
                            <button type="submit" formaction="/api/jobs/send-now" formnovalidate class="w-full sm:flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition shadow-md text-base">
                                <i class="fas fa-bolt mr-1 text-yellow-300"></i> ยิงด่วนทันที
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                
                <div class="bg-white p-5 md:p-6 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 border-b pb-3 text-gray-700">
                        <i class="fas fa-history mr-2 text-green-500"></i> สถานะการทำงานล่าสุด (LINE)
                    </h2>

                    <div class="block md:hidden space-y-4">
                        <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                            <% jobs.forEach(job => { %>
                                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 space-y-2">
                                    <div class="flex justify-between items-center">
                                        <span class="text-xs bg-green-100 text-green-800 px-2 py-0.5 rounded font-bold">
                                            <%= job.mode === 'KEYWORD' ? '👀 จองหลังเรท' : '⏰ ตั้งเวลา' %>
                                        </span>
                                        <div>
                                            <% if (job.status === 'SUCCESS') { %>
                                                <span class="text-xs text-green-600 font-bold bg-green-50 px-2 py-1 rounded-lg">สำเร็จ</span>
                                            <% } else if (job.status === 'RUNNING') { %>
                                                <span class="text-xs text-blue-600 font-bold bg-blue-50 px-2 py-1 rounded-lg animate-pulse">ดักจับคำ...</span>
                                            <% } else if (job.status === 'FAILED') { %>
                                                <span class="text-xs text-red-600 font-bold bg-red-50 px-2 py-1 rounded-lg">ล้มเหลว</span>
                                            <% } else { %>
                                                <span class="text-xs text-yellow-600 font-bold bg-yellow-50 px-2 py-1 rounded-lg">รอดำเนินการ</span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <p class="text-sm font-bold text-gray-800 truncate"><i class="fab fa-line mr-1 text-green-500"></i> <%= job.targetUrl %></p>
                                    <p class="text-xs text-gray-600"><%= job.message %></p>
                                    <p class="text-[10px] text-gray-400"><%= new Date(job.runAt).toLocaleString('th-TH') %></p>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p class="text-center text-gray-400 py-6">ยังไม่มีประวัติการสั่งงาน</p>
                        <% } %>
                    </div>

                    <div class="hidden md:block overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-50 text-gray-600">
                                <tr>
                                    <th class="px-4 py-3 rounded-l-xl">กลุ่มเป้าหมาย</th>
                                    <th class="px-4 py-3">ข้อความ</th>
                                    <th class="px-4 py-3">เวลาสั่งงาน</th>
                                    <th class="px-4 py-3 rounded-r-xl">สถานะ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                                    <% jobs.forEach(job => { %>
                                        <tr class="border-b border-gray-50 hover:bg-gray-50">
                                            <td class="px-4 py-4 font-bold text-gray-800"><%= job.targetUrl %></td>
                                            <td class="px-4 py-4 text-gray-600"><%= job.message %></td>
                                            <td class="px-4 py-4 text-xs text-gray-500">
                                                <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold block mb-1 w-max text-[10px]">
                                                    <%= job.mode === 'KEYWORD' ? 'จองหลังเรท' : 'ตั้งเวลา' %>
                                                </span>
                                                <%= new Date(job.runAt).toLocaleString('th-TH') %>
                                            </td>
                                            <td class="px-4 py-4">
                                                <% if (job.status === 'SUCCESS') { %>
                                                    <span class="text-green-600 font-bold bg-green-50 px-2 py-1 rounded-lg"><i class="fas fa-check-circle mr-1"></i> สำเร็จ</span>
                                                <% } else if (job.status === 'RUNNING') { %>
                                                    <span class="text-blue-600 font-bold bg-blue-50 px-2 py-1 rounded-lg"><i class="fas fa-spinner fa-spin mr-1"></i> ดักจับคำ...</span>
                                                <% } else if (job.status === 'FAILED') { %>
                                                    <span class="text-red-600 font-bold bg-red-50 px-2 py-1 rounded-lg"><i class="fas fa-times-circle mr-1"></i> ล้มเหลว</span>
                                                <% } else { %>
                                                    <span class="text-yellow-600 font-bold bg-yellow-50 px-2 py-1 rounded-lg"><i class="fas fa-clock mr-1"></i> รอคิว</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        function toggleLineMode() {
            const mode = document.querySelector('input[name="mode"]:checked').value;
            const keywordBox = document.getElementById('lineKeywordBox');
            if (mode === 'KEYWORD') {
                keywordBox.classList.remove('hidden');
                document.getElementsByName('keyword')[0].required = true;
            } else {
                keywordBox.classList.add('hidden');
                document.getElementsByName('keyword')[0].required = false;
            }
        }
    </script>
</body>
</html>
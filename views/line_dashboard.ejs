<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LINE Bot Dashboard - Welloff</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-10">

    <%- include('partials/navbar') %>

    <div class="max-w-7xl mx-auto px-4 mt-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
            
            <div class="space-y-6 md:space-y-8">
                
                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 flex items-center text-green-600">
                        <i class="fab fa-line mr-2 text-2xl"></i> เพิ่มบัญชีไลน์ (ส่วนตัว)
                    </h2>
                    
                    <% if (lineAccounts.length >= user.lineLimit) { %>
                        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-3 md:p-4 mb-6 rounded-r-lg">
                            <p class="text-yellow-700 text-xs md:text-sm font-medium">⚠️ บัญชีไลน์ของคุณเต็มแล้ว</p>
                        </div>
                    <% } %>

                    <form action="/api/line/add" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">ชื่อบัญชีไลน์ (ตั้งไว้อ้างอิง)</label>
                            <input type="text" name="groupName" placeholder="เช่น ไลน์ส่วนตัว - น้องจี" required 
                                class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none text-sm md:text-base">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Cookies บัญชี LINE</label>
                            <textarea name="cookies" placeholder='[{"name":"...", "value":"..."}]' required 
                                class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none h-24 text-sm"></textarea>
                            <p class="text-xs text-red-500 mt-1">* ใช้ Cookie-Editor ดึงค่าจากเว็บ LINE (ทำเหมือน Facebook)</p>
                        </div>
                        
                        <button type="submit" 
                            <% if (lineAccounts.length >= user.lineLimit) { %>disabled<% } %>
                            class="w-full <% if (lineAccounts.length >= user.lineLimit) { %>bg-gray-300 cursor-not-allowed<% } else { %>bg-green-600 hover:bg-green-700 shadow-md<% } %> text-white font-bold py-3 rounded-xl transition">
                            บันทึกบัญชีไลน์
                        </button>
                    </form>
                </div>

                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 flex items-center text-green-600">
                        <i class="fas fa-paper-plane mr-2"></i> สั่งงานบอท (LINE)
                    </h2>
                    
                    <form action="/api/jobs/add" method="POST" class="space-y-4">
                        <div class="p-4 bg-blue-50 border border-blue-100 rounded-xl mb-4">
                            <label class="block text-sm font-semibold text-gray-800 mb-2">รูปแบบการทำงาน</label>
                            <div class="flex gap-4">
                                <label class="flex items-center cursor-pointer">
                                    <input type="radio" name="mode" value="SCHEDULE" checked class="w-4 h-4 text-blue-600 focus:ring-blue-500">
                                    <span class="ml-2 text-sm text-gray-700">⏰ ตั้งเวลาส่ง</span>
                                </label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">จำนวนข้อความที่ต้องการส่ง</label>
                            <select name="repeat" class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                                <option value="1">1 ข้อความ</option>
                                <option value="2">2 ข้อความ</option>
                                <option value="3">3 ข้อความ</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">เลือกบัญชีไลน์ (ที่จะใช้พิมพ์)</label>
                            <select name="accountId" required class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none bg-white">
                                <option value="" disabled selected>-- เลือกบัญชีไลน์ --</option>
                                <% if (lineAccounts && lineAccounts.length > 0) { %>
                                    <% lineAccounts.forEach(acc => { %>
                                        <option value="<%= acc.id %>"><%= acc.groupName %></option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="" disabled>ยังไม่มีบัญชีไลน์</option>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-red-600 mb-1">ชื่อกลุ่มเป้าหมาย (พิมพ์ให้ตรงเป๊ะๆ)</label>
                            <input type="text" name="targetUrl" placeholder="เช่น กลุ่มแชร์เงินล้าน วีไอพี" required 
                                class="w-full border-red-200 bg-red-50 border p-3 rounded-xl focus:ring-2 focus:ring-red-500 outline-none">
                            <p class="text-xs text-gray-500 mt-1">* บอทจะนำชื่อนี้ไปค้นหาในหน้าไลน์</p>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">ข้อความที่ต้องการส่ง</label>
                            <textarea name="message" rows="3" required 
                                class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none text-sm md:text-base"></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">เวลาที่ต้องการส่ง (ถ้าตั้งเวลา)</label>
                            <input type="datetime-local" name="runAt" class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-green-500 outline-none">
                        </div>
                        
                        <div class="flex flex-col sm:flex-row gap-3 pt-2">
                            <button type="submit" class="w-full sm:flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition shadow-md">
                                ยืนยันการตั้งค่า
                            </button>
                            <button type="submit" formaction="/api/jobs/send-now" formnovalidate class="w-full sm:flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition shadow-md">
                                <i class="fas fa-bolt mr-1 text-yellow-300"></i> ส่งทันที
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6 md:space-y-8">
                
                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 border-b pb-3 text-gray-700">📋 บัญชีไลน์ที่พร้อมใช้งาน</h2>
                    
                    <% if (lineAccounts.length === 0) { %>
                        <div class="text-center py-12 text-gray-400">
                            <i class="fas fa-user-circle text-5xl mb-4 opacity-20"></i>
                            <p>ยังไม่มีบัญชีไลน์ในระบบ</p>
                        </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% lineAccounts.forEach(acc => { %>
                                <div class="border p-4 md:p-5 rounded-xl hover:border-green-400 transition bg-gray-50 shadow-sm flex flex-col justify-between h-full">
                                    <div class="flex justify-between items-start gap-2">
                                        <div class="w-full overflow-hidden">
                                            <p class="font-bold text-gray-800 text-base md:text-lg truncate"><i class="fab fa-line text-green-500 mr-1"></i> <%= acc.groupName %></p>
                                        </div>
                                        <span class="bg-green-100 text-green-700 text-[10px] px-2 py-1 rounded-full font-bold shadow-sm whitespace-nowrap">READY</span>
                                    </div>
                                    <div class="mt-4 pt-3 border-t border-gray-200 flex justify-end items-center">
                                        <button onclick="deleteLineAccount('<%= acc.id %>')" class="text-xs font-bold text-red-500 hover:text-red-700 bg-red-50 px-3 py-1 rounded-lg">
                                            ลบบัญชี
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 border-b pb-3 text-gray-700">
                        <i class="fas fa-history mr-2 text-blue-500"></i> สถานะการทำงานล่าสุด (LINE)
                    </h2>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-50 text-gray-600">
                                <tr>
                                    <th class="px-4 py-3 rounded-l-xl">เป้าหมาย (กลุ่ม)</th>
                                    <th class="px-4 py-3">ข้อความ</th>
                                    <th class="px-4 py-3">เวลาที่บันทึก</th>
                                    <th class="px-4 py-3 rounded-r-xl">สถานะ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                                    <% jobs.forEach(job => { %>
                                        <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                            <td class="px-4 py-4 font-bold text-gray-800 truncate max-w-[120px]">
                                                <%= job.targetUrl %>
                                            </td>
                                            <td class="px-4 py-4 text-gray-600 truncate max-w-[150px]">
                                                <%= job.message %>
                                            </td>
                                            <td class="px-4 py-4 text-gray-500 text-xs">
                                                <span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded font-bold block mb-1 w-max">ตั้งเวลา</span>
                                                <%= new Date(job.runAt).toLocaleString('th-TH') %>
                                            </td>
                                            <td class="px-4 py-4">
                                                <% if (job.status === 'SUCCESS') { %>
                                                    <span class="text-green-600 font-bold bg-green-50 px-2 py-1 rounded-lg whitespace-nowrap"><i class="fas fa-check-circle mr-1"></i> สำเร็จ</span>
                                                <% } else if (job.status === 'RUNNING') { %>
                                                    <span class="text-blue-600 font-bold bg-blue-50 px-2 py-1 rounded-lg whitespace-nowrap"><i class="fas fa-spinner fa-spin mr-1"></i> กำลังทำงาน</span>
                                                <% } else if (job.status === 'FAILED') { %>
                                                    <span class="text-red-600 font-bold bg-red-50 px-2 py-1 rounded-lg whitespace-nowrap"><i class="fas fa-times-circle mr-1"></i> ล้มเหลว</span>
                                                <% } else { %>
                                                    <span class="text-yellow-600 font-bold bg-yellow-50 px-2 py-1 rounded-lg whitespace-nowrap"><i class="fas fa-clock mr-1"></i> รอดำเนินการ</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-8 text-gray-400">
                                            <i class="fas fa-inbox text-3xl mb-3 opacity-30 block"></i>
                                            ยังไม่มีประวัติการสั่งงาน
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
    <script>
        async function deleteLineAccount(id) {
            if(!confirm('ยืนยันว่าจะลบบัญชีนี้ออกจากระบบ?')) return;
            try {
                const res = await fetch(`/api/line/delete/${id}`, { method: 'DELETE' });
                if(res.ok) {
                    location.reload(); 
                } else {
                    alert('ลบไม่ได้: ' + (await res.text()));
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการเชื่อมต่อ');
            }
        }
    </script>
</body>
</html>
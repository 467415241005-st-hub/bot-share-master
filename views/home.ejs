<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welloff — ระบบจองแชร์อัตโนมัติที่เร็วที่สุด</title>
    <meta name="description" content="ระบบจองแชร์อัตโนมัติที่เร็วที่สุดและเสถียรที่สุด รองรับ Facebook และ LINE ราคาเริ่มต้น 500 บาท/เดือน">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --green: #22c55e;
            --green-dark: #16a34a;
            --green-light: #bbf7d0;
            --blue: #3b82f6;
            --dark: #0f172a;
            --dark-2: #1e293b;
            --dark-3: #334155;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --white: #ffffff;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Kanit', sans-serif; background: var(--dark); color: var(--text); line-height: 1.6; }
        a { text-decoration: none; color: inherit; }

        /* NAV */
        nav {
            position: sticky; top: 0; z-index: 100;
            background: rgba(15,23,42,0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.07);
            padding: 0 1.5rem;
        }
        .nav-inner {
            max-width: 1100px; margin: 0 auto;
            display: flex; align-items: center; justify-content: space-between;
            height: 64px;
        }
        .nav-logo { font-size: 1.5rem; font-weight: 800; color: var(--white); letter-spacing: -.5px; }
        .nav-logo span { color: var(--green); }
        .nav-links { display: flex; gap: 2rem; align-items: center; }
        .nav-links a { font-size: .9rem; color: var(--muted); font-weight: 500; transition: color .2s; }
        .nav-links a:hover { color: var(--white); }
        .nav-btns { display: flex; gap: .75rem; align-items: center; }
        .btn-outline { border: 1px solid var(--dark-3); padding: .5rem 1.25rem; border-radius: 8px; font-size: .85rem; font-weight: 600; color: var(--text); transition: all .2s; font-family: 'Kanit', sans-serif; background: transparent; cursor: pointer; }
        .btn-outline:hover { border-color: var(--green); color: var(--green); }
        .btn-green { background: var(--green); padding: .5rem 1.25rem; border-radius: 8px; font-size: .85rem; font-weight: 700; color: var(--dark); transition: all .2s; font-family: 'Kanit', sans-serif; cursor: pointer; border: none; }
        .btn-green:hover { background: var(--green-dark); transform: translateY(-1px); }

        /* HERO */
        .hero {
            min-height: calc(100vh - 64px);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-align: center; padding: 5rem 1.5rem;
            position: relative; overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(34,197,94,.15), transparent);
            pointer-events: none;
        }
        .hero-badge {
            display: inline-flex; align-items: center; gap: .5rem;
            background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.25);
            border-radius: 999px; padding: .35rem 1rem; font-size: .78rem; font-weight: 600;
            color: var(--green); letter-spacing: .05em; text-transform: uppercase; margin-bottom: 2rem;
        }
        .hero-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
        @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.6)} }
        .hero h1 { font-size: clamp(2.2rem, 5.5vw, 4rem); font-weight: 800; line-height: 1.1; margin-bottom: 1.5rem; letter-spacing: -.02em; }
        .hero h1 .accent { color: var(--green); }
        .hero p { font-size: 1.1rem; color: var(--muted); max-width: 540px; margin: 0 auto 2.5rem; line-height: 1.75; font-weight: 300; }
        .hero-tags { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; margin-bottom: 2.5rem; }
        .hero-tag { background: var(--dark-2); border: 1px solid var(--dark-3); border-radius: 8px; padding: .35rem .85rem; font-size: .82rem; color: var(--muted); }
        .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
        .btn-hero-primary { background: var(--green); color: var(--dark); padding: .85rem 2.2rem; border-radius: 12px; font-weight: 700; font-size: 1rem; transition: all .2s; display: inline-flex; align-items: center; gap: .5rem; font-family: 'Kanit', sans-serif; }
        .btn-hero-primary:hover { background: var(--green-dark); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(34,197,94,.3); }
        .btn-hero-secondary { background: var(--dark-2); color: var(--text); padding: .85rem 2.2rem; border-radius: 12px; font-weight: 600; font-size: 1rem; border: 1px solid var(--dark-3); transition: all .2s; display: inline-flex; align-items: center; gap: .5rem; font-family: 'Kanit', sans-serif; }
        .btn-hero-secondary:hover { border-color: var(--green); color: var(--green); }

        /* STATS */
        .stats { background: var(--dark-2); border-top: 1px solid var(--dark-3); border-bottom: 1px solid var(--dark-3); padding: 3rem 1.5rem; }
        .stats-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; text-align: center; }
        .stat-num { font-size: 2.2rem; font-weight: 800; color: var(--white); }
        .stat-label { font-size: .8rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-top: .25rem; }

        /* PRODUCTS */
        .section { max-width: 1100px; margin: 0 auto; padding: 5rem 1.5rem; }
        .section-badge { display: inline-block; background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.2); color: var(--green); border-radius: 6px; padding: .25rem .75rem; font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1rem; }
        .section-title { font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; margin-bottom: .75rem; }
        .section-sub { color: var(--muted); font-size: 1rem; font-weight: 300; max-width: 480px; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
        .product-card {
            background: var(--dark-2); border: 1px solid var(--dark-3);
            border-radius: 20px; padding: 2rem; transition: all .3s;
            display: flex; flex-direction: column;
        }
        .product-card:hover { border-color: var(--green); transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,.3); }
        .product-icon { width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1.25rem; }
        .icon-fb { background: rgba(59,130,246,.15); color: #60a5fa; }
        .icon-line { background: rgba(34,197,94,.15); color: var(--green); }
        .product-name { font-size: 1.2rem; font-weight: 700; margin-bottom: .5rem; }
        .product-desc { color: var(--muted); font-size: .9rem; font-weight: 300; margin-bottom: 1.5rem; line-height: 1.7; }
        .product-features { list-style: none; margin-bottom: 2rem; flex: 1; }
        .product-features li { display: flex; align-items: flex-start; gap: .6rem; font-size: .88rem; color: var(--muted); margin-bottom: .65rem; font-weight: 300; }
        .product-features li i { color: var(--green); font-size: .75rem; margin-top: .35rem; flex-shrink: 0; }
        .product-features li.unavailable i { color: var(--dark-3); }
        .product-features li.unavailable { opacity: .6; }
        .product-btn { display: block; text-align: center; background: var(--dark-3); color: var(--text); padding: .75rem; border-radius: 10px; font-weight: 600; font-size: .9rem; transition: all .2s; }
        .product-btn:hover { background: var(--green); color: var(--dark); }

        /* WHY */
        .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
        .why-card { background: var(--dark-2); border: 1px solid var(--dark-3); border-radius: 16px; padding: 1.75rem; transition: border-color .2s; }
        .why-card:hover { border-color: rgba(34,197,94,.4); }
        .why-icon { width: 44px; height: 44px; border-radius: 12px; background: rgba(34,197,94,.1); color: var(--green); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; margin-bottom: 1rem; }
        .why-title { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; }
        .why-desc { font-size: .85rem; color: var(--muted); font-weight: 300; line-height: 1.65; }

        /* PRICING PREVIEW */
        .pricing-preview { background: var(--dark-2); border-radius: 24px; border: 1px solid var(--dark-3); padding: 3rem 2rem; margin-top: 3rem; text-align: center; }
        .pricing-preview h3 { font-size: 1.5rem; font-weight: 700; margin-bottom: .5rem; }
        .pricing-preview p { color: var(--muted); font-size: .95rem; font-weight: 300; margin-bottom: 2rem; }
        .price-cards { display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center; }
        .price-card { background: var(--dark); border: 1px solid var(--dark-3); border-radius: 16px; padding: 1.75rem 2rem; min-width: 200px; text-align: left; transition: all .2s; }
        .price-card.featured { border-color: var(--green); position: relative; }
        .price-card.featured::before { content: 'แนะนำ'; position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--green); color: var(--dark); font-size: .7rem; font-weight: 700; padding: .2rem .75rem; border-radius: 999px; }
        .price-name { font-size: .8rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .5rem; }
        .price-amount { font-size: 2rem; font-weight: 800; color: var(--white); }
        .price-amount span { font-size: .85rem; font-weight: 400; color: var(--muted); }
        .price-desc { font-size: .82rem; color: var(--muted); margin-top: .4rem; font-weight: 300; }

        /* CTA */
        .cta-section { background: linear-gradient(135deg, rgba(34,197,94,.1), rgba(59,130,246,.05)); border: 1px solid rgba(34,197,94,.2); border-radius: 24px; padding: 4rem 2rem; text-align: center; margin-top: 3rem; }
        .cta-section h2 { font-size: 2rem; font-weight: 800; margin-bottom: 1rem; }
        .cta-section p { color: var(--muted); font-size: 1rem; font-weight: 300; margin-bottom: 2rem; }

        /* FOOTER */
        footer { background: var(--dark-2); border-top: 1px solid var(--dark-3); padding: 2rem 1.5rem; text-align: center; }
        .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
        .footer-logo { font-size: 1.2rem; font-weight: 800; }
        .footer-logo span { color: var(--green); }
        footer p { font-size: .82rem; color: var(--muted); }
        .footer-links { display: flex; gap: 1.5rem; }
        .footer-links a { font-size: .82rem; color: var(--muted); transition: color .2s; }
        .footer-links a:hover { color: var(--green); }

        /* HAMBURGER */
        .hamburger { display: none; background: none; border: none; color: var(--text); font-size: 1.4rem; cursor: pointer; padding: .5rem; }
        .mobile-menu { display: none; background: var(--dark-2); border-top: 1px solid var(--dark-3); padding: 1rem 1.5rem; flex-direction: column; gap: .5rem; }
        .mobile-menu a { padding: .75rem 0; border-bottom: 1px solid var(--dark-3); color: var(--muted); font-size: .95rem; font-weight: 500; display: block; }
        .mobile-menu a:last-child { border-bottom: none; }
        .mobile-menu.open { display: flex; }

        @media (max-width: 768px) {
            .nav-links, .nav-btns { display: none; }
            .hamburger { display: block; }
            .stats-inner { grid-template-columns: repeat(2, 1fr); }
            .hero { padding: 3rem 1rem; min-height: auto; }
            .footer-inner { flex-direction: column; text-align: center; }
        }
    </style>
</head>

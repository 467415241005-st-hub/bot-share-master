<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Welloff</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-10">

    <%- include('partials/navbar') %>

    <div class="max-w-7xl mx-auto px-4 mt-6">
        <div class="bg-gradient-to-r from-blue-600 to-blue-500 text-white p-6 md:p-8 rounded-2xl shadow-lg flex flex-col sm:flex-row items-center text-center sm:text-left mb-8">
            <div class="bg-white/20 p-4 rounded-xl mb-4 sm:mb-0 sm:mr-6 text-4xl">🤖</div>
            <div>
                <h1 class="text-2xl md:text-3xl font-bold">Bot Share Master</h1>
                <p class="opacity-80 text-sm md:text-base mt-1">ระบบจัดการบอทจองแชร์ (เซิร์ฟเวอร์ส่วนตัว)</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
            
            <div class="space-y-6 md:space-y-8">
                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 flex items-center"><i class="fas fa-plus-circle mr-2 text-blue-500"></i> เพิ่มบัญชี Facebook</h2>
                    <form action="/api/accounts/add" method="POST" class="space-y-4">
                        <input type="text" name="fbEmail" placeholder="อีเมล/เบอร์โทร" required class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                        <input type="password" name="fbPassword" placeholder="รหัสผ่าน" required class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                        <textarea name="cookies" placeholder='[{"name":"c_user",...}]' class="w-full border-gray-200 border p-3 rounded-xl h-24 text-xs font-mono focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                        <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 shadow-md transition">บันทึกบัญชี</button>
                    </form>
                </div>

                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 flex items-center text-blue-600">
                        <i class="fas fa-clock mr-2"></i> สั่งงานบอท (Facebook)
                    </h2>
                    <form action="/api/jobs/add" method="POST" class="space-y-4" id="jobForm">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">เลือกบัญชีบอท</label>
                            <select name="accountId" required class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                                <% accounts.forEach(acc => { %>
                                    <option value="<%= acc.id %>"><%= acc.fbEmail %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">ลิงก์โพสต์ที่ต้องการจอง</label>
                            <input type="url" name="targetUrl" placeholder="https://www.facebook.com/..." required 
                                class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none text-sm md:text-base">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">ข้อความที่จะคอมเมนต์</label>
                            <input type="text" name="message" placeholder="เช่น จองครับ, รับครับ" required 
                                class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">เวลาที่ให้บอททำงาน (ถ้าไม่ตั้งจะส่งทันที)</label>
                            <input type="datetime-local" name="runAt" 
                                class="w-full border-gray-200 border p-3 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                        
                        <div class="flex gap-2">
                            <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition shadow-md">
                                ตั้งเวลาจอง
                            </button>
                            <button type="button" onclick="sendNow()" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl transition shadow-md">
                                🚀 ส่งทันที
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-8">
                
                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h2 class="text-lg md:text-xl font-bold mb-4 md:mb-6 border-b pb-3 text-gray-700">📋 บัญชีบอทที่พร้อมใช้งาน</h2>
                    <% if (accounts.length === 0) { %>
                        <div class="text-center py-12 text-gray-400">
                            <i class="fas fa-users-slash text-4xl mb-3 opacity-30"></i>
                            <p>ยังไม่มีบัญชีในระบบ</p>
                        </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% accounts.forEach(acc => { %>
                                <div class="bg-gray-50 border p-4 rounded-xl shadow-sm hover:bg-white hover:border-blue-300 transition flex justify-between items-center gap-3">
                                    <div class="w-full truncate">
                                        <p class="font-bold text-gray-800 truncate"><i class="fab fa-facebook text-blue-600 mr-2"></i><%= acc.fbEmail %></p>
                                        <p class="text-xs text-gray-400 mt-1">ID: <%= acc.id %></p>
                                        <span class="inline-block mt-1 text-[10px] bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-bold">READY</span>
                                    </div>
                                    <button onclick="openDeleteModal('<%= acc.id %>')" class="text-red-500 text-sm hover:text-red-700 hover:underline font-medium bg-red-50 p-2 rounded-lg transition shrink-0">
                                        <i class="fas fa-trash-alt sm:hidden mr-1"></i>ลบ
                                    </button>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-100">
                    <h3 class="text-lg md:text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-history text-blue-600"></i> สถานะการทำงานล่าสุด
                    </h3>
                    <div class="overflow-x-auto rounded-xl border border-gray-100">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead class="bg-gray-50 text-gray-500 text-xs uppercase font-bold">
                                <tr>
                                    <th class="p-4">เวลา</th>
                                    <th class="p-4">บัญชี</th>
                                    <th class="p-4">ข้อความ</th>
                                    <th class="p-4">สถานะ</th>
                                </tr>
                            </thead>
                            <tbody class="text-sm">
                                <% if(jobs.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-8 text-gray-400">ยังไม่มีประวัติการสั่งงาน</td>
                                    </tr>
                                <% } else { %>
                                    <% jobs.forEach(job => { %>
                                        <tr class="border-t border-gray-50 hover:bg-gray-50 transition">
                                            <td class="p-4 text-gray-500 whitespace-nowrap"><%= job.runAt.toLocaleString('th-TH') %></td>
                                            <td class="p-4 font-medium"><%= job.account ? job.account.fbEmail : 'บัญชีถูกลบ' %></td>
                                            <td class="p-4 text-gray-600 truncate max-w-[200px]"><%= job.message %></td>
                                            <td class="p-4">
                                                <span class="px-2 py-1 rounded-full text-xs font-bold 
                                                    <%= job.status === 'SUCCESS' ? 'bg-green-100 text-green-600' : 
                                                        job.status === 'FAILED' ? 'bg-red-100 text-red-600' : 
                                                        'bg-yellow-100 text-yellow-600' %>">
                                                    <%= job.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="deleteModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full mx-4 transform scale-95 transition-transform duration-300" id="deleteModalCard">
            <div class="p-6 text-center">
                <div class="w-20 h-20 mx-auto bg-red-50 rounded-full flex items-center justify-center mb-5 border-[6px] border-red-100">
                    <i class="fas fa-trash-alt text-3xl text-red-500"></i>
                </div>
                
                <h3 class="text-2xl font-bold text-gray-800 mb-2">ยืนยันการลบ?</h3>
                <p class="text-gray-500 text-sm mb-6 leading-relaxed">
                    คุณแน่ใจหรือไม่ว่าต้องการลบบัญชีนี้? <br>
                    <span class="text-red-500 font-medium">หากลบแล้ว งานที่ตั้งเวลาไว้จะถูกยกเลิกทั้งหมด</span>
                </p>
                
                <div class="flex gap-3">
                    <button onclick="closeDeleteModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition">
                        ยกเลิก
                    </button>
                    <button onclick="confirmDelete()" id="confirmDeleteBtn" class="flex-1 bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-xl transition shadow-md shadow-red-500/30">
                        ใช่, ลบเลย
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div id="successModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full mx-4 transform scale-95 transition-transform duration-300 p-6 text-center" id="successModalCard">
            <div class="w-20 h-20 mx-auto bg-green-50 rounded-full flex items-center justify-center mb-5 border-[6px] border-green-100">
                <i class="fas fa-check text-4xl text-green-500"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 mb-2">สำเร็จ!</h3>
            <p class="text-gray-500 mb-6" id="successMsg">ทำรายการเรียบร้อยแล้ว</p>
        </div>
    </div>

    <div id="errorModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm transition-opacity duration-300 opacity-0">
        <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full mx-4 transform scale-95 transition-transform duration-300 p-6 text-center" id="errorModalCard">
            <div class="w-20 h-20 mx-auto bg-red-50 rounded-full flex items-center justify-center mb-5 border-[6px] border-red-100">
                <i class="fas fa-times text-4xl text-red-500"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 mb-2">ผิดพลาด!</h3>
            <p class="text-gray-500 mb-6" id="errorMsg">เกิดข้อผิดพลาด กรุณาลองใหม่</p>
            <button onclick="closeErrorModal()" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition">
                ตกลง
            </button>
        </div>
    </div>
<script>
// --- ระบบจัดการ Modal ลบบัญชี ---
let accountIdToDelete = null;

function openDeleteModal(id) {
    accountIdToDelete = id;
    const modal = document.getElementById('deleteModal');
    const card = document.getElementById('deleteModalCard');
    modal.classList.remove('hidden');
    setTimeout(() => { modal.classList.remove('opacity-0'); card.classList.remove('scale-95'); }, 10);
}

function closeDeleteModal() {
    accountIdToDelete = null;
    const modal = document.getElementById('deleteModal');
    const card = document.getElementById('deleteModalCard');
    modal.classList.add('opacity-0'); card.classList.add('scale-95');
    setTimeout(() => { modal.classList.add('hidden'); }, 300);
}

// --- ระบบ Card แจ้งเตือน (สวยงาม) ---
function showSuccess(msg) {
    document.getElementById('successMsg').innerText = msg;
    const modal = document.getElementById('successModal');
    const card = document.getElementById('successModalCard');
    modal.classList.remove('hidden');
    setTimeout(() => { modal.classList.remove('opacity-0'); card.classList.remove('scale-95'); }, 10);
    
    // โชว์ความสำเร็จ 1.5 วินาที แล้วรีเฟรชหน้าต่างอัตโนมัติ
    setTimeout(() => { location.reload(); }, 1500);
}

function showError(msg) {
    document.getElementById('errorMsg').innerText = msg;
    const modal = document.getElementById('errorModal');
    const card = document.getElementById('errorModalCard');
    modal.classList.remove('hidden');
    setTimeout(() => { modal.classList.remove('opacity-0'); card.classList.remove('scale-95'); }, 10);
}

function closeErrorModal() {
    const modal = document.getElementById('errorModal');
    const card = document.getElementById('errorModalCard');
    modal.classList.add('opacity-0'); card.classList.add('scale-95');
    setTimeout(() => { modal.classList.add('hidden'); }, 300);
}

// --- ยืนยันการลบของจริง ---
async function confirmDelete() {
    if (!accountIdToDelete) return;
    
    const btn = document.getElementById('confirmDeleteBtn');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังลบ...';
    btn.disabled = true;

    try {
        const res = await fetch('/api/accounts/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accountId: accountIdToDelete })
        });
        
        closeDeleteModal(); // ปิดหน้าต่างยืนยันอันเก่าก่อน
        
        if(res.ok) {
            showSuccess('ลบบัญชีและประวัติงานเรียบร้อยแล้ว');
        } else {
            showError('ลบไม่สำเร็จ กรุณาลองใหม่');
        }
    } catch(err) {
        closeDeleteModal();
        showError('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}

// --- ฟังก์ชันส่งทันที ---
async function sendNow() {
    const accountId = document.querySelector('select[name="accountId"]').value;
    const targetUrl = document.querySelector('input[name="targetUrl"]').value;
    const message = document.querySelector('input[name="message"]').value; 

    if(!targetUrl || !message) return showError('กรุณากรอกลิงก์และข้อความให้ครบ');

    const btn = event.currentTarget;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังส่ง...';
    btn.disabled = true;

    try {
        const res = await fetch('/api/facebook/send-now', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accountId, targetUrl, message })
        });
        
        if(res.ok) {
            showSuccess('สั่งงานบอทเฟซบุ๊กสำเร็จ!');
        } else {
            const data = await res.json();
            // ⭐ ให้โชว์ Error จริงๆ ที่ส่งมาจากเซิร์ฟเวอร์
            showError('เกิดข้อผิดพลาด: ' + (data.error || 'ไม่ทราบสาเหตุ'));
        }
    } catch(err) {
        showError('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้');
    } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
    }
}
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facebook Bot - Welloff</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 pb-12 font-sans antialiased text-gray-900">
    <%- include('partials/navbar') %>

    <div class="max-w-7xl mx-auto px-4 mt-6">
        <div class="bg-blue-600 text-white p-6 rounded-3xl shadow-md mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-extrabold">Welloff Facebook Bot</h1>
                <p class="text-sm">สถานะแพ็กเกจ: <span class="font-bold text-yellow-300"><%= user.packageStatus %></span></p>
            </div>
            <% if(user.packageStatus === 'FREE') { %>
                <a href="/topup" class="bg-white text-blue-600 px-4 py-2 rounded-xl font-bold text-sm">อัปเกรด 150฿</a>
            <% } %>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="font-bold text-blue-600 mb-4 border-b pb-2">ผูกบัญชี Facebook</h2>
                    <form action="/api/facebook/add" method="POST" class="space-y-3">
                        <input type="text" name="fbEmail" required placeholder="อีเมล/เบอร์" class="w-full border p-2 rounded-xl text-sm">
                        <input type="password" name="fbPassword" required placeholder="รหัสผ่าน" class="w-full border p-2 rounded-xl text-sm">
                        <button class="w-full bg-slate-800 text-white py-2 rounded-xl text-sm font-bold">เพิ่มบัญชี</button>
                    </form>
                </div>

                <!-- รายการบัญชี Facebook -->
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <h2 class="font-bold text-blue-600 mb-4 border-b pb-2">บัญชีที่เชื่อมต่อไว้</h2>
                    <div class="space-y-2">
                        <% if(accounts && accounts.length > 0) { accounts.forEach(acc => { %>
                            <div class="flex justify-between items-center bg-gray-50 border border-gray-100 p-3 rounded-xl">
                                <div>
                                    <p class="font-bold text-sm text-gray-800"><%= acc.fbEmail %></p>
                                    <p class="text-[10px] text-gray-400">ID: <%= acc.id %></p>
                                </div>
                                <button onclick="deleteFbAccount(<%= acc.id %>)" class="text-red-500 text-xs font-bold px-2 hover:text-red-700">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        <% }) } else { %>
                            <p class="text-sm text-gray-400 text-center py-2">ยังไม่มีบัญชี</p>
                        <% } %>
                    </div>
                </div>
                    <form id="fbJobForm" class="space-y-4">
                        <input type="hidden" id="platform" value="FACEBOOK">
                        
                        <select id="accountId" class="w-full border p-3 rounded-xl font-bold">
                            <% if(accounts.length > 0) { accounts.forEach(acc => { %>
                                <option value="<%= acc.id %>"><%= acc.fbEmail %></option>
                            <% }) } else { %>
                                <option value="">กรุณาเพิ่มบัญชีเฟสบุ๊คก่อน</option>
                            <% } %>
                        </select>

                        <div class="grid grid-cols-3 gap-2">
                            <label class="cursor-pointer"><input type="radio" name="mode" value="IMMEDIATE" checked onchange="toggleMode()" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-blue-600 peer-checked:text-white text-xs font-bold">ด่วน</div></label>
                            <label class="cursor-pointer"><input type="radio" name="mode" value="SCHEDULE" onchange="toggleMode()" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-blue-600 peer-checked:text-white text-xs font-bold">ตั้งเวลา</div></label>
                            <label class="cursor-pointer"><input type="radio" name="mode" value="KEYWORD" onchange="toggleMode()" class="peer sr-only"><div class="text-center py-2 border rounded-xl peer-checked:bg-blue-600 peer-checked:text-white text-xs font-bold">คีย์เวิร์ด</div></label>
                        </div>

                        <input type="datetime-local" id="scheduleTime" class="w-full border p-2 rounded-xl text-sm hidden">
                        <input type="text" id="keyword" placeholder="คำที่ต้องการดัก (เช่น เรท)" class="w-full border p-2 rounded-xl text-sm hidden">
                        
                        <input type="url" id="targetUrl" required placeholder="ลิงก์โพสต์เป้าหมาย" class="w-full border p-3 rounded-xl text-sm">
                        <textarea id="message" required placeholder="ข้อความจอง" class="w-full border p-3 rounded-xl text-sm"></textarea>
                        
                        <button type="button" onclick="submitJob()" class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl">ส่งงาน</button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100">
                    <div class="flex justify-between items-center border-b pb-3 mb-4">
                        <h2 class="font-bold text-gray-700">ประวัติงานล่าสุด</h2>
                        <button onclick="clearHistory('facebook')" class="text-xs text-red-500">ล้างประวัติ</button>
                    </div>
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50"><tr><th class="p-3">โหมด</th><th class="p-3">ข้อความ</th><th class="p-3">เวลาส่ง</th><th class="p-3">สถานะ</th></tr></thead>
                        <tbody>
                            <% jobs.forEach(job => { %>
                                <tr class="border-b" data-job-id="<%= job.id %>" data-status="<%= job.status %>">
                                    <td class="p-3 font-bold text-blue-600"><%= job.mode %></td>
                                    <td class="p-3 truncate max-w-[150px]"><%= job.message %></td>
                                    <td class="p-3 text-xs"><%= new Date(job.runAt).toLocaleString('th-TH') %></td>
                                    <td class="p-3">
                                        <span class="status-badge font-bold <%= job.status === 'DONE' ? 'text-green-600' : job.status === 'FAILED' ? 'text-red-500' : job.status === 'RUNNING' ? 'text-blue-500' : 'text-gray-500' %>">
                                            <%= job.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleMode() {
            const mode = document.querySelector('input[name="mode"]:checked').value;
            document.getElementById('scheduleTime').classList.toggle('hidden', mode !== 'SCHEDULE');
            document.getElementById('keyword').classList.toggle('hidden', mode !== 'KEYWORD');
        }

        async function submitJob() {
            const data = {
                platform: document.getElementById('platform').value,
                accountId: document.getElementById('accountId').value,
                mode: document.querySelector('input[name="mode"]:checked').value,
                targetUrl: document.getElementById('targetUrl').value,
                message: document.getElementById('message').value,
                scheduleTime: document.getElementById('scheduleTime').value,
                keyword: document.getElementById('keyword').value,
                repeat: 1
            };
            if(!data.accountId) return alert('โปรดเพิ่มบัญชีก่อน');
            
            const res = await fetch('/api/jobs/send', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
            });
            if(res.ok) location.reload();
        }

        async function clearHistory(platform) {
            if(confirm('ล้างประวัติ?')) {
                await fetch(`/api/jobs/clear/${platform}`, { method: 'DELETE' });
                location.reload();
            }
        }

        async function deleteFbAccount(id) {
            if(confirm('ยืนยันลบบัญชี Facebook นี้? ประวัติงานของบัญชีนี้จะถูกลบด้วย')) {
                const res = await fetch(`/api/facebook/delete/${id}`, { method: 'DELETE' });
                if(res.ok) location.reload();
                else alert('ลบไม่สำเร็จ');
            }
        }

        // Auto-refresh สถานะงานที่กำลัง RUNNING ทุก 5 วินาที
        async function refreshRunningJobs() {
            const runningRows = document.querySelectorAll('[data-job-id][data-status="RUNNING"]');
            if (runningRows.length === 0) return;
            
            const res = await fetch('/api/jobs/status');
            if (!res.ok) return;
            const data = await res.json();
            
            runningRows.forEach(row => {
                const jobId = parseInt(row.dataset.jobId);
                const job = data.jobs.find(j => j.id === jobId);
                if (job && job.status !== 'RUNNING') {
                    const badge = row.querySelector('.status-badge');
                    if (badge) {
                        badge.textContent = job.status;
                        badge.className = 'status-badge font-bold ' + 
                            (job.status === 'DONE' ? 'text-green-600' : 
                             job.status === 'FAILED' ? 'text-red-500' : 'text-gray-500');
                    }
                    row.dataset.status = job.status;
                }
            });
        }
        setInterval(refreshRunningJobs, 5000);
    </script>
</body>
</html>
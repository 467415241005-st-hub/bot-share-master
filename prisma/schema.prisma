// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password      String
  credits       Float    @default(0)
  role          String   @default("USER") // USER, ADMIN
  packageStatus String   @default("FREE") // FREE (1 บัญชี), PAID (2 บัญชี)
  createdAt     DateTime @default(now())

  accounts      BotAccount[]
  lineAccs      LineAccount[]
  payments      Payment[]
}

model BotAccount {
  id         Int      @id @default(autoincrement())
  fbEmail    String   @unique
  fbPassword String
  cookies    String   @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  jobs       JobQueue[]
}

model LineAccount {
  id           Int      @id @default(autoincrement())
  groupName    String   
  loginType    String   @default("COOKIE") 
  lineEmail    String?
  linePassword String? 
  cookies      String?  @db.Text 
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  jobs         JobQueue[]
}

model JobQueue {
  id            Int      @id @default(autoincrement())
  targetUrl     String   
  message       String
  status        String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  runAt         DateTime @default(now())
  mode          String   @default("IMMEDIATE") // IMMEDIATE, SCHEDULE, KEYWORD
  keyword       String?
  repeat        Int      @default(1) 
  platform      String   @default("FACEBOOK") 
  
  accountId     Int?
  lineAccountId Int?     
  account       BotAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lineAccount   LineAccount? @relation(fields: [lineAccountId], references: [id], onDelete: Cascade)
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  slipUrl   String   
  status    String   @default("PENDING") 
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  email      String   @unique
  password   String
  credits    Float    @default(0)
  lineLimit  Int      @default(1) // โควต้าจำนวนกลุ่ม/บัญชี LINE
  createdAt  DateTime @default(now())
  lineAccs   LineAccount[]
  accounts   BotAccount[]
}

model LineAccount {
  id           Int      @id @default(autoincrement())
  groupName    String   // ชื่อบัญชีเอาไว้อ้างอิง
  loginType    String   @default("COOKIE") 
  lineEmail    String?  
  linePassword String? 
  cookies      String?  @db.Text // ✨ เก็บ Cookie บัญชีส่วนตัว
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  jobs         JobQueue[]
}

model JobQueue {
  id            Int      @id @default(autoincrement())
  targetUrl     String   // ชื่อกลุ่มเป้าหมาย (ในไลน์) หรือ URL โพสต์ (ในเฟส)
  message       String
  status        String   @default("PENDING") 
  runAt         DateTime @default(now())
  mode          String   @default("SCHEDULE") 
  keyword       String?
  repeat        Int      @default(1) 
  platform      String   @default("FACEBOOK") 
  accountId     Int?     // สำหรับ Facebook
  lineAccountId Int?     // ✨ เชื่อมกับบัญชี LINE ส่วนตัว
  account       BotAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lineAccount   LineAccount? @relation(fields: [lineAccountId], references: [id], onDelete: Cascade)
}